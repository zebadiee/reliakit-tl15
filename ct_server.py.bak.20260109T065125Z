@app.post("/agent/hello")
def agent_hello(body: dict):
    agent_id = body.get("agent_id")
    if not agent_id:
        raise HTTPException(400, "agent_id required")

    d = db()
    c = d.cursor()

    # Use explicit columns to avoid schema drift (fixes “5 columns but 4 values” cases).
    c.execute(
        "INSERT OR IGNORE INTO agents (agent_id, role, revoked, created_at) VALUES (?, ?, ?, ?)",
        (agent_id, "readonly", 0, utcnow_iso())
    )
    d.commit()
    d.close()

    return {
        "node": NODE_ID,
        "role": NODE_ROLE,
        "agent_role": "readonly",
        "locked": True
    }


@app.post("/agent/escalate")
def agent_escalate(body: dict):
    agent_id = body.get("agent_id")
    role = body.get("role")
    if role not in ("readonly", "writer", "executor"):
        raise HTTPException(400, "invalid role")

    d = db()
    c = d.cursor()
    c.execute(
        "UPDATE agents SET role=? WHERE agent_id=? AND revoked=0",
        (role, agent_id)
    )
    d.commit()
    d.close()

    return {"ok": True, "agent_id": agent_id, "role": role}


@app.post("/agent/revoke")
def agent_revoke(body: dict):
    agent_id = body.get("agent_id")
    d = db()
    c = d.cursor()
    c.execute("UPDATE agents SET revoked=1 WHERE agent_id=?", (agent_id,))
    d.commit()
    d.close()
    return {"ok": True, "revoked": agent_id}


# =========================================================
# Admin key registry (Step-6 crypto anchor)
# =========================================================

def load_agent_pubkey(agent_id: str) -> Optional[str]:
    d = db()
    c = d.cursor()
    c.execute("SELECT pubkey FROM agent_keys WHERE agent_id=?", (agent_id,))
    row = c.fetchone()
    d.close()
    return row[0] if row else None


@app.post("/admin/register_key")
def register_key(body: dict):
    agent_id = body.get("agent_id")
    pubkey = body.get("pubkey")  # expected: OpenSSH "ssh-ed25519 AAAA... comment"
    if not agent_id or not pubkey:
        raise HTTPException(400, "agent_id and pubkey required")

    d = db()
    c = d.cursor()
    c.execute(
        "INSERT OR REPLACE INTO agent_keys (agent_id, pubkey, added_at) VALUES (?, ?, ?)",
        (agent_id, pubkey.strip(), utcnow_iso())
    )
    d.commit()
    d.close()
    return {"ok": True, "agent_id": agent_id}


def _verify_ed25519(agent_id: str, message: str, signature_b64: str) -> bool:
    if not REQUIRE_SIGNATURES:
        return True
    if not _CRYPTO_OK:
        raise HTTPException(status_code=503, detail="crypto backend not installed (cryptography)")

    pub = load_agent_pubkey(agent_id)
    if not pub:
        raise HTTPException(status_code=403, detail="no public key registered for agent")

    # Parse OpenSSH pubkey line: "ssh-ed25519 AAAAC3... comment"
    parts = pub.split()
    if len(parts) < 2 or parts[0] != "ssh-ed25519":
        raise HTTPException(status_code=400, detail="invalid pubkey format")

    import base64
    keydata = base64.b64decode(parts[1].encode())

    # OpenSSH wire format: string "ssh-ed25519", string key_bytes
    # We minimally parse it.
    def read_u32(b, off):
        return int.from_bytes(b[off:off+4], "big"), off+4

    def read_str(b, off):
        ln, off = read_u32(b, off)
        return b[off:off+ln], off+ln

    off = 0
    t, off = read_str(keydata, off)
    if t != b"ssh-ed25519":
        raise HTTPException(status_code=400, detail="pubkey type mismatch")
    k, off = read_str(keydata, off)

    pk = Ed25519PublicKey.from_public_bytes(k)
    sig = base64.b64decode(signature_b64.encode())
    try:
        pk.verify(sig, message.encode())
        return True
    except Exception:
        return False


# =========================================================
# Event ingestion (tamper-evident)
# =========================================================

@app.post("/event")
def log_event(body: dict):
    agent_id = body.get("agent_id")
    etype = body.get("type")
    payload = body.get("payload")

    if not agent_id or not etype or payload is None or payload == "":
        raise HTTPException(status_code=400, detail="agent_id, type, payload required")

    d = db()
    c = d.cursor()

    c.execute("SELECT role, revoked FROM agents WHERE agent_id=?", (agent_id,))
    row = c.fetchone()
    if row is None:
        d.close()
        raise HTTPException(status_code=403, detail="unknown agent")

    role, revoked = row
    if revoked:
        d.close()
        raise HTTPException(status_code=403, detail="agent revoked")

    if role not in ("writer", "executor"):
        d.close()
        raise HTTPException(status_code=403, detail="insufficient role")

    c.execute("SELECT hash FROM events ORDER BY id DESC LIMIT 1")
    prev = c.fetchone()
    prev_hash = prev[0] if prev else ""

    ts = utcnow_iso()
    h = hash_chain(prev_hash, ts, agent_id, etype, str(payload))

    c.execute(
        "INSERT INTO events (ts, agent_id, type, payload, prev_hash, hash) VALUES (?, ?, ?, ?, ?, ?)",
        (ts, agent_id, etype, str(payload), prev_hash, h)
    )

    d.commit()
    d.close()

    return {"ok": True, "hash": h}


# =========================================================
# Lease contracts (Step-6)
# =========================================================

def _agent_role(agent_id: str) -> str:
    d = db()
    c = d.cursor()
    c.execute("SELECT role, revoked FROM agents WHERE agent_id=?", (agent_id,))
    row = c.fetchone()
    d.close()
    if not row:
        raise HTTPException(status_code=403, detail="unknown agent")
    role, revoked = row
    if revoked:
        raise HTTPException(status_code=403, detail="agent revoked")
    return role


@app.post("/lease/request")
def lease_request(req: LeaseRequest):
    # 1) Governance check
    role = _agent_role(req.agent_id)
    if role != "executor":
        raise HTTPException(status_code=403, detail="executor role required")

    # 2) Optional signature verification (OFF by default)
    # Canonical message binds request parameters + nonce.
    nonce = req.nonce or ""
    msg = f"{req.agent_id}|{req.task_id}|{req.scope}|{nonce}"
    if REQUIRE_SIGNATURES:
        if not req.signature:
            raise HTTPException(status_code=403, detail="signature required")
        if not _verify_ed25519(req.agent_id, msg, req.signature):
            raise HTTPException(status_code=403, detail="bad signature")

    # 3) Issue lease
    lease_id = str(uuid.uuid4())
    issued_at = utcnow_iso()
    expires_at = (datetime.now(timezone.utc) + timedelta(minutes=15)).isoformat()

    lease_hash = hashlib.sha256(
        f"{lease_id}|{req.task_id}|{req.agent_id}|{req.scope}|{issued_at}|{expires_at}".encode()
    ).hexdigest()

    d = db()
    c = d.cursor()
    c.execute(
        "INSERT INTO leases (lease_id, task_id, agent_id, scope, issued_at, expires_at, state, hash) "
        "VALUES (?, ?, ?, ?, ?, ?, ?, ?)",
        (lease_id, req.task_id, req.agent_id, req.scope, issued_at, expires_at, "ACTIVE", lease_hash)
    )
    d.commit()
    d.close()

    return {
        "status": "GRANTED",
        "lease_id": lease_id,
        "expires_at": expires_at,
        "hash": lease_hash
    }


@app.post("/lease/complete")
def lease_complete(res: LeaseComplete):
    # basic sanity
    role = _agent_role(res.agent_id)
    if role != "executor":
        raise HTTPException(status_code=403, detail="executor role required")

    d = db()
    c = d.cursor()
    c.execute("SELECT agent_id, expires_at, state FROM leases WHERE lease_id=?", (res.lease_id,))
    row = c.fetchone()
    if not row:
        d.close()
        raise HTTPException(status_code=404, detail="lease not found")

    lease_agent, expires_at, state = row
    if lease_agent != res.agent_id:
        d.close()
        raise HTTPException(status_code=403, detail="lease not owned by agent")

    if state != "ACTIVE":
        d.close()
        raise HTTPException(status_code=400, detail=f"cannot close lease in state {state}")

    # expiry check
    try:
        exp = datetime.fromisoformat(expires_at)
    except Exception:
        exp = datetime.now(timezone.utc)  # fail closed-ish; treat as expired
    if datetime.now(timezone.utc) > exp:
        c.execute("UPDATE leases SET state='EXPIRED' WHERE lease_id=?", (res.lease_id,))
        d.commit()
        d.close()
        raise HTTPException(status_code=408, detail="lease expired")

    final_state = "COMPLETED" if res.success else "FAILED"
    c.execute("UPDATE leases SET state=? WHERE lease_id=?", (final_state, res.lease_id))
    d.commit()
    d.close()

    # log closure into tamper-evident chain
    payload = f"Lease {res.lease_id} {final_state}"
    if res.receipt:
        payload += f" | receipt={res.receipt}"

    # Event logging requires writer/executor: agent is executor, so OK
    log_event({"agent_id": res.agent_id, "type": "LEASE_CLOSED", "payload": payload})

    return {"status": "CLOSED", "final_state": final_state}
