#!/usr/bin/env python3
import os
import sqlite3
import hashlib
import uuid
from datetime import datetime, timedelta, timezone
from typing import Optional

from fastapi import FastAPI, HTTPException, Request
from pydantic import BaseModel

# =========================================================
# Core identity
# =========================================================

NODE_ID = os.environ.get("CT_NODE_ID", "invictus")
NODE_ROLE = os.environ.get("CT_NODE_ROLE", "authoritative")

BASE = os.path.expanduser("~/invictus")
DATA_DIR = os.environ.get("CT_DATA", f"{BASE}/data")
DB_PATH = os.path.join(DATA_DIR, "ct_memory.db")

# Network / auth hardening toggles (safe defaults)
REQUIRE_TAILSCALE = os.environ.get("CT_REQUIRE_TAILSCALE", "0") == "1"
REQUIRE_SIGNATURES = os.environ.get("CT_REQUIRE_SIGS", "0") == "1"

app = FastAPI(title="CT Invictus Control Plane")

# =========================================================
# Optional crypto (Ed25519 verification)
# =========================================================

_CRYPTO_OK = False
try:
    from cryptography.hazmat.primitives.asymmetric.ed25519 import Ed25519PublicKey
    from cryptography.hazmat.primitives import serialization
    _CRYPTO_OK = True
except Exception:
    _CRYPTO_OK = False


def utcnow_iso() -> str:
    # timezone-aware UTC timestamp (avoids deprecated utcnow)
    return datetime.now(timezone.utc).isoformat()


def db():
    # one connection per request/operation; keep it simple and predictable
    return sqlite3.connect(DB_PATH)


def hash_chain(prev: str, ts: str, agent: str, etype: str, payload: str) -> str:
    h = hashlib.sha256()
    h.update((prev or "").encode())
    h.update(ts.encode())
    h.update(agent.encode())
    h.update(etype.encode())
    h.update(payload.encode())
    return h.hexdigest()


def init_db():
    os.makedirs(DATA_DIR, exist_ok=True)
    d = sqlite3.connect(DB_PATH)
    c = d.cursor()

    c.execute("""
    CREATE TABLE IF NOT EXISTS node_identity (
        node_id TEXT PRIMARY KEY,
        role TEXT NOT NULL,
        locked INTEGER NOT NULL,
        locked_at TEXT NOT NULL
    )
    """)

    # NOTE: Your DB may already have an agents schema. We do not drop/alter.
    # We only create if absent. If schema differs, use explicit column INSERTs below.
    c.execute("""
    CREATE TABLE IF NOT EXISTS agents (
        agent_id TEXT PRIMARY KEY,
        role TEXT NOT NULL,
        revoked INTEGER NOT NULL DEFAULT 0,
        created_at TEXT NOT NULL
    )
    """)

    c.execute("""
    CREATE TABLE IF NOT EXISTS events (
        id INTEGER PRIMARY KEY AUTOINCREMENT,
        ts TEXT NOT NULL,
        agent_id TEXT NOT NULL,
        type TEXT NOT NULL,
        payload TEXT NOT NULL,
        prev_hash TEXT,
        hash TEXT NOT NULL
    )
    """)

    c.execute("""
    CREATE TABLE IF NOT EXISTS revoked_certs (
        fingerprint TEXT PRIMARY KEY,
        revoked_at TEXT NOT NULL
    )
    """)

    # Lease contracts (Step-6)
    c.execute("""
    CREATE TABLE IF NOT EXISTS leases (
        lease_id TEXT PRIMARY KEY,
        task_id TEXT NOT NULL,
        agent_id TEXT NOT NULL,
        scope TEXT NOT NULL,
        issued_at TEXT NOT NULL,
        expires_at TEXT NOT NULL,
        state TEXT NOT NULL, -- ACTIVE, COMPLETED, FAILED, EXPIRED
        hash TEXT NOT NULL
    )
    """)

    # Agent public keys (Ed25519)
    c.execute("""
    CREATE TABLE IF NOT EXISTS agent_keys (
        agent_id TEXT PRIMARY KEY,
        pubkey TEXT NOT NULL,
        added_at TEXT NOT NULL
    )
    """)

    c.execute("SELECT COUNT(*) FROM node_identity")
    if c.fetchone()[0] == 0:
        c.execute(
            "INSERT INTO node_identity VALUES (?, ?, ?, ?)",
            (NODE_ID, NODE_ROLE, 1, utcnow_iso())
        )

    d.commit()
    d.close()


init_db()

# =========================================================
# Request hardening (optional)
# =========================================================

def _is_tailscale_ip(ip: str) -> bool:
    # IPv4 tailscale range is 100.64.0.0/10, commonly seen as 100.x.x.x
    # We'll accept anything starting with "100." plus the local loopback for local testing.
    if ip in ("127.0.0.1", "::1"):
        return True
    return ip.startswith("100.")


@app.middleware("http")
async def tailscale_only(request: Request, call_next):
    if REQUIRE_TAILSCALE:
        client_ip = request.client.host if request.client else ""
        if not _is_tailscale_ip(client_ip):
            return HTTPException(status_code=403, detail="tailscale-only")
    return await call_next(request)


